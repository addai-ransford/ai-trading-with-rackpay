# RackPay local development environment
# Copy to .env and replace secrets where required.
# Never commit .env or real credentials.

RACKPAY_DATABASE_URL=jdbc:postgresql://localhost:5432/rackpay
RACKPAY_DATABASE_USERNAME=rackpay
RACKPAY_DATABASE_PASSWORD=rackpay
RACKPAY_DB_POOL_SIZE=10

RACKPAY_KEYCLOAK_BASE_URL=http://localhost:8081
RACKPAY_KEYCLOAK_REALM=rackpay
RACKPAY_KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/rackpay
RACKPAY_KEYCLOAK_ADMIN_CLIENT_ID=rackpay-admin
RACKPAY_KEYCLOAK_ADMIN_CLIENT_SECRET=change-me

RACKPAY_WALLET_DEFAULT_CURRENCY=EUR

RACKPAY_PAYMENT_ENVIRONMENT=sandbox

RACKPAY_MOLLIE_BASE_URL=https://api.mollie.com/v2
RACKPAY_MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxx
RACKPAY_MOLLIE_WEBHOOK_SECRET=change-me

RACKPAY_STRIPE_BASE_URL=https://api.stripe.com/v1
RACKPAY_STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxx
RACKPAY_STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxx
