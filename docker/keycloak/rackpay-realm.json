{
  "realm": "rackpay",
  "enabled": true,
  "displayName": "RackPay",
  "loginTheme": "rackpay",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "RackPay application user"
      },
      {
        "name": "ADMIN",
        "description": "Legacy identity role; RackPay API authorization is database-backed"
      }
    ]
  },
  "clients": [
    {
      "clientId": "rackpay-mobile",
      "name": "RackPay Mobile App",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "publicClient": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:4000/*"
      ],
      "webOrigins": [
        "http://localhost:4000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "rackpay-admin",
      "name": "RackPay Backend Admin Client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "change-me-local",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "service-account-rackpay-admin",
      "enabled": true,
      "serviceAccountClientId": "rackpay-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "query-users",
          "view-users"
        ]
      }
    }
  ]
}