VITE_API_BASE_URL=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=rackpay
VITE_KEYCLOAK_CLIENT_ID=rackpay-mobile
# Optional for web; native Capacitor auth will use its configured deep link.
VITE_KEYCLOAK_REDIRECT_URI=http://localhost:4000/
# Public callback URL supplied to the payment provider. Backend route: /api/v1/payments/webhooks/{provider}.
# Use a publicly reachable API URL for provider callbacks; localhost is not reachable by the provider.
VITE_PAYMENT_WEBHOOK_URL=
